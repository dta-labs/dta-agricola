{
  "rules": {
    ".read": true,
    ".write": "auth != null",
    "systems": {
      "$systemId": {
        "logs": {
          ".indexOn": ["date"]
        },
        "dayLogs": {
          ".indexOn": ["date"]
        }
      }
    },
    "users": {
      "$userKey": {
        "fcmTokens": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "fcmStatus": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
